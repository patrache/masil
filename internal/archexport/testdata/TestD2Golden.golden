b3.b4.b1.n1 -> b3.b4.b1.n9: "TCP · 0.2ms"
b3.b4.b2.n2 -> b3.b4.b2.n10: "TCP · 1.5ms"
b3.b4.b2.n2 -> b3.b4.b2.n6: "async" {style.stroke-dash: 3}
b3.b4.b2.n6 -> n5: "HTTP/1.1"
b3.b4.b1.n1 -> b3.b4.n11: "gRPC"
b3.b4.b2.n2 -> n8: "HTTP/1.1"
