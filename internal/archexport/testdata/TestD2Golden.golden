}
n12 -> n4: "HTTP/1.1"
n4 -> b3.b4.n7: "HTTP/2 · 2ms"
b3.b4.n7 -> b3.b4.b1.n1: "HTTP/1.1"
b3.b4.n7 -> b3.b4.b2.n2: "HTTP/1.1"
