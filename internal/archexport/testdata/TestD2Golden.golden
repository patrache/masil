# two lines
direction: right
b3: {
  label: "서울 리전"
  b4: {
    label: "본 VPC"
    b1: {
      label: "가용 영역 A"
      n1: {
        label: "결제 API"
      }
      n3: {
        label: "세션 캐시"
      }
      n9: {
        label: "주 DB"
        shape: cylinder
      }
    }
    b2: {
      label: "가용 영역 B"
      n2: {
        label: "결제 API"
      }
      n6: {
        label: "작업 큐"
        shape: queue
      }
      n10: {
        label: "읽기 복제본"
        shape: cylinder
      }
    }
    n7: {
      label: "부하 분산기"
    }
    n11: {
      label: "주문 검색"
    }
  }
}
n4: {
  label: "CDN"
  shape: cloud
}
n5: {
  label: "영수증 저장소"
